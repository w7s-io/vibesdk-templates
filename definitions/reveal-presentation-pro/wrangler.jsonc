/**
 * Reveal.js presentation static assets.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "reveal-presentation",
	"compatibility_date": "2025-04-24",
	"assets": {
		"directory": "public",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
